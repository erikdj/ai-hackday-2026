# Copy to .env and fill in. .env is gitignored. Add a blank line here for every new credential.

# Crusoe Managed Inference (REQUIRED for prize qualification). OpenAI-compatible.
# Key from the Crusoe Cloud console (Intelligence API key). Ask the sponsor desk for hackday credits.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model id from GET $CRUSOE_BASE_URL/models. Must support tool calling for agent use.
CRUSOE_MODEL=

# OpenRouter (optional graph Q&A and explicitly enabled, loudly logged last-resort fallback).
OPENROUTER_API_KEY=
OPENROUTER_PRESET=@preset/duplo-crusoe-glm

# Band (multi-agent coordination, Tier 1 for HALLWAY). From https://app.band.ai/agents
# Six remote agents (Desk, Scribe, Researcher, Critic, Grapher, Closer). Per-agent id + key live in
# agent_config.yaml at repo root (gitignored); BAND_CONFIG_PATH may override it.
# Legacy BAND_AGENT_ID/API_KEY are retained for Erik's single-agent smoke tooling only.
BAND_AGENT_ID=
BAND_API_KEY=

# Nebius AI Studio (embeddings for entity resolution). OpenAI-compatible.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_EMBED_MODEL=

# Brave Search API (Researcher). Header X-Subscription-Token.
BRAVE_API_KEY=

# Merge.dev unified CRM (Closer writes Contact + Opportunity + Note).
MERGE_API_KEY=
MERGE_ACCOUNT_TOKEN=

# Reserved integration mocks (1 = mock); downstream integrations are not implemented yet.
# Current Band/Crusoe runtime never uses a mock transport.
MOCK_BAND=0
MOCK_CRUSOE=0
MOCK_NEO4J=0
MOCK_BRAVE=1
MOCK_MERGE=1
MOCK_NEBIUS=1

# Neo4j AuraDB (optional). From console.neo4j.io connection details.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Vultr (optional). Account > Manage User > API Access.
VULTR_API_KEY=

# DuploCloud devkit remote target (optional; local stack needs nothing here).
DUPLO_HOST=
DUPLO_TOKEN=

# Exact Crusoe IDs discovered and tool-call tested by scripts/smoke_models.py.
CRUSOE_MODEL_STRONG=
CRUSOE_MODEL_FAST=
CRUSOE_MODEL_CRITIC=
# Families must differ for the strong worker and Critic.
CRUSOE_FAMILY_STRONG=
CRUSOE_FAMILY_CRITIC=
# NOT_IMPLEMENTED: reserved alternate Crusoe catalog ID; current runtime fails loudly.
CRUSOE_MODEL_FALLBACK=
# NOT_IMPLEMENTED: reserved fallback model; current runtime never uses OpenRouter.
OPENROUTER_MODEL_FALLBACK=

# Band lobby room and local secret file (not committed).
BAND_LOBBY_ROOM_ID=
BAND_CONFIG_PATH=agent_config.yaml

# Band human API key for the live CLI demo trigger (never use Desk self-messaging).
BAND_HUMAN_API_KEY=
# Optional verified room URL pattern containing {room_id}; no guessed app route.
BAND_ROOM_URL_TEMPLATE=

# Match the numeric owner of host agent_config.yaml for read-only Docker binding.
# Defaults suit UID/GID 1000; set to the file owner on your deployment host.
HALLWAY_UID=1000
HALLWAY_GID=1000
