# Copy to .env and fill in. .env is gitignored. Add a blank line here for every new credential.

# Crusoe Managed Inference (REQUIRED for prize qualification). OpenAI-compatible.
# Key from the Crusoe Cloud console (Intelligence API key). Ask the sponsor desk for hackday credits.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model id from GET $CRUSOE_BASE_URL/models. Must support tool calling for agent use.
CRUSOE_MODEL=

# OpenRouter (reserved graph Q&A only; no agent uses an external fallback).
OPENROUTER_API_KEY=
OPENROUTER_PRESET=@preset/duplo-crusoe-glm

# Band (required HANDOFF coordination). From https://app.band.ai/agents
# Phase 1 requires Desk, Scribe, Critic; Researcher/Grapher/Closer are deferred.
# Per-agent id + key live in
# agent_config.yaml at repo root (gitignored); BAND_CONFIG_PATH may override it.
# Legacy BAND_AGENT_ID/API_KEY are retained for Erik's single-agent smoke tooling only.
BAND_AGENT_ID=
BAND_API_KEY=

# Deferred Nebius AI Studio: pseudonymous prior-encounter suggestions, never auto-merge.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_EMBED_MODEL=

# Deferred Brave Search API (Researcher); drug names only. Header X-Subscription-Token.
BRAVE_API_KEY=

# Cut at HANDOFF pivot: legacy Merge.dev credentials retained; no CRM writes.
MERGE_API_KEY=
MERGE_ACCOUNT_TOKEN=

# make demo: BOTH MOCK_BAND=1 and MOCK_CRUSOE=1 select the OFFLINE unit-test harness.
# BOTH 0 select live; mixed modes fail. No live failure falls back to the harness.
# The runtime has no mock transport; offline tests are not a sponsor demo.
MOCK_BAND=0
MOCK_CRUSOE=0
# Reserved downstream flags, not implemented; MOCK_MERGE is cut legacy.
MOCK_NEO4J=0
MOCK_BRAVE=1
MOCK_MERGE=1
MOCK_NEBIUS=1

# Deferred Neo4j AuraDB clinical memory + access lineage. From console.neo4j.io.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Vultr (optional). Account > Manage User > API Access.
VULTR_API_KEY=

# Cut: legacy DuploCloud devkit credentials retained; no HANDOFF deployment integration.
DUPLO_HOST=
DUPLO_TOKEN=

# Exact Crusoe IDs discovered and tool-call tested by scripts/smoke_models.py.
CRUSOE_MODEL_STRONG=
CRUSOE_MODEL_FAST=
CRUSOE_MODEL_CRITIC=
# Families must differ for the strong worker and Critic.
CRUSOE_FAMILY_STRONG=
CRUSOE_FAMILY_CRITIC=
# Required catalog-verified secondary Crusoe model; no external provider fallback.
CRUSOE_MODEL_FALLBACK=

# Band lobby room and local secret file (not committed).
BAND_LOBBY_ROOM_ID=
BAND_CONFIG_PATH=agent_config.yaml

# Band human API key for the live CLI demo trigger (never use Desk self-messaging).
BAND_HUMAN_API_KEY=
# Optional verified room URL pattern containing {room_id}; no guessed app route.
BAND_ROOM_URL_TEMPLATE=

# Match the numeric owner of host agent_config.yaml for read-only Docker binding.
# Defaults suit UID/GID 1000; set to the file owner on your deployment host.
HALLWAY_UID=1000
HALLWAY_GID=1000

# Optional role-specific fallback overrides (catalog IDs; Crusoe only).
CRUSOE_MODEL_FAST_FALLBACK=
CRUSOE_MODEL_STRONG_FALLBACK=
CRUSOE_MODEL_CRITIC_FALLBACK=

# LOCAL DESK ONLY: private salt file, generated once; never copy it to a cloud host.
HANDOFF_PSEUDONYM_SALT_FILE=~/.handoff/pseudonym-salt
# xAI (optional, dev tooling only). Used by scripts/make_fixtures.py to synthesize demo audio
# with xAI voices; without it the script falls back to edge-tts. Never on the product path.
XAI_API_KEY=
